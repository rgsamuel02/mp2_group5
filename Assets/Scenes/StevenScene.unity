  - name: Lunch Rush
    goalText: Serve 5 covers
    resource: 5
    amount: 5
    useSecondCondition: 0
    resource2: 2
    amount2: 60
    revealTitle: 'UNLOCKED: STEAK'
    revealBody: 'The butcher now sells beef, and the grill has a Grilled Steak ticket.
      Steak needs herbs: snip them from the herb plants with the shears.'
    unlocks:
    - {fileID: 1879498857}
    - {fileID: 855942312}
    - {fileID: 479048332}
