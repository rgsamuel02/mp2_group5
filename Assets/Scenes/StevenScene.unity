    resource: 0
    amount: 400
    useSecondCondition: 0
    resource2: 2
    amount2: 60
    revealTitle: 'UNLOCKED: EQUIPMENT CATALOG'
    revealBody: Buy new equipment from the catalog shelf. Pick up a miniature and
